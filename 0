(function(){
  const VERSION = '2024.01.15.3';
  const stored = localStorage.getItem('dartpro_version');
  if (stored && stored !== VERSION) {
    localStorage.setItem('dartpro_version', VERSION);
    location.reload(true);
  } else if (!stored) {
    localStorage.setItem('dartpro_version', VERSION);
