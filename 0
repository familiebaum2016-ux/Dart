// TEAM VIEW
async function loadTeamData() {
  if (!APP.team) return;
  const tid = APP.team.id;
  const [mRes,pmRes,penRes,incRes,expRes,annRes] = await Promise.all([
    sb.from('members').select('*').eq('team_id',tid).order('name'),
    sb.from('paid_months').select('*'),
    sb.from('penalties').select('*').order('date',{ascending:false}),
    sb.from('other_income').select('*').eq('team_id',tid).order('date',{ascending:false}),
    sb.from('other_expenses').select('*').eq('team_id',tid).order('date',{ascending:false}),
    sb.from('announcements').select('*').or(`team_id.eq.${tid},team_id.is.null`).order('created_at',{ascending:false}),
  ]);
  const incomeRows = incRes.data||[];
  APP.members=mRes.data||[]; APP.paidMonths=pmRes.data||[]; APP.penalties=penRes.data||[];
  APP.registrations=incomeRows.map(parseRegistrationMarker).filter(Boolean);
  APP.felgeEntries=incomeRows.map(parseFelgeMarker).filter(Boolean);
  APP.felgeSeasonList=incomeRows.map(parseFelgeSeasonMarker).filter(Boolean);
  APP.otherIncome=incomeRows.filter(i=>!parseRegistrationMarker(i)&&!parseFelgeMarker(i)&&!parseFelgeSeasonMarker(i));
  APP.otherExpenses=expRes.data||[]; APP.announcements=annRes.data||[];
  currentFelgeSeason = loadCurrentFelgeSeason();
}

function getMemberPM(mid) { return APP.paidMonths.filter(pm=>pm.member_id===mid); }
function getMemberPen(mid) { return APP.penalties.filter(p=>p.member_id===mid); }
function parseRegistrationMarker(row) {
  const desc = row?.description || '';
  if (!desc.startsWith(REGISTRATION_MARKER_PREFIX)) return null;
  const parts = desc.split('|');
  if (parts.length < 3) return null;
  return { id: row.id, season: parts[1], member_id: parts[2] };
}
// Felge-Eintrag: __FELGE__|<season>|<member_id>|<count>
function parseFelgeMarker(row) {
  const desc = row?.description || '';
  if (!desc.startsWith(FELGE_MARKER_PREFIX)) return null;
  const parts = desc.split('|');
  if (parts.length < 4) return null;
  return { id: row.id, season: parts[1], member_id: parts[2], count: parseInt(parts[3],10)||0 };
}
// Felge-Saison-Anlage (nur Marker, damit Saison in DB existiert): __FELGE_SEASON__|<season>
function parseFelgeSeasonMarker(row) {
  const desc = row?.description || '';
  if (!desc.startsWith(FELGE_SEASON_MARKER_PREFIX)) return null;
  const parts = desc.split('|');
  if (parts.length < 2) return null;
  return { id: row.id, season: parts[1] };
}
function registrationSeasonStart(season) {
  const match = String(season||'').match(/^(\d{4})\/\d{4}$/);
  return match ? parseInt(match[1],10) : 2026;
}
function registrationSeasonLabel(startYear) { return `${startYear}/${startYear+1}`; }
function registrationSeasonOptions() {
  const currentStart = registrationSeasonStart(currentRegistrationSeason);
  const first = Math.min(2026, currentStart - 2);
  const last = Math.max(2035, currentStart + 5);
  const opts = [];
  for (let y=first; y<=last; y++) opts.push(registrationSeasonLabel(y));
  return opts;
}
function isRegistrationPaid(memberId, season=currentRegistrationSeason) {
  return APP.registrations.some(r=>r.season===season && String(r.member_id)===String(memberId));
}

// ── FELGE-SAISON MANAGEMENT (Supabase-basiert) ──
// Daten kommen aus other_income mit Marker (__FELGE__|<season>|<mid>|<count> und __FELGE_SEASON__|<season>).
// Nur "aktuelle Saison" pro Team bleibt lokal (reine UI-Auswahl).
function felgeCurrentSeasonKey(teamId){ return 'dartpro_felge_current_season_team_'+teamId; }
function loadCurrentFelgeSeason(){
  if (!APP.team) return 'Saison 1';
  return localStorage.getItem(felgeCurrentSeasonKey(APP.team.id)) || 'Saison 1';
}
function saveCurrentFelgeSeason(s){
  if (!APP.team) return;
  localStorage.setItem(felgeCurrentSeasonKey(APP.team.id), s);
}
function felgeSeasonNumber(s){
  const m = String(s||'').match(/(\d+)/);
  return m ? parseInt(m[1],10) : 1;
}
function felgeSeasonLabel(n){ return 'Saison '+n; }
function felgeAvailableSeasons(){
  const nums = new Set([1]);
  (APP.felgeSeasonList||[]).forEach(r=>nums.add(felgeSeasonNumber(r.season)));
  (APP.felgeEntries||[]).forEach(r=>nums.add(felgeSeasonNumber(r.season)));
  nums.add(felgeSeasonNumber(currentFelgeSeason));
  return Array.from(nums).sort((a,b)=>a-b).map(felgeSeasonLabel);
}
function getFelgeCountForMember(memberId, season){
  if (season === 'Saison 1') {
    const m = APP.members.find(x=>String(x.id)===String(memberId));
    return m ? (m.felge_count||0) : 0;
  }
  const row = (APP.felgeEntries||[]).find(r=>r.season===season && String(r.member_id)===String(memberId));
  return row ? (row.count||0) : 0;
}
async function setFelgeCountForMember(memberId, season, count){
  if (season === 'Saison 1') return;
  const c = Math.max(0, parseInt(count,10)||0);
  const existing = (APP.felgeEntries||[]).find(r=>r.season===season && String(r.member_id)===String(memberId));
  const marker = `${FELGE_MARKER_PREFIX}${season}|${memberId}|${c}`;
  if (existing) {
    const {error} = await sb.from('other_income').update({description:marker}).eq('id',existing.id);
    if (error) { alert('Fehler beim Speichern: '+error.message); return; }
  } else {
    const today = new Date().toISOString().slice(0,10);
    const {error} = await sb.from('other_income').insert({team_id:APP.team.id,description:marker,amount:0,date:today});
    if (error) { alert('Fehler beim Speichern: '+error.message); return; }
  }
}
async function ensureFelgeSeasonExists(season){
  if (!season || season==='Saison 1') return;
  const exists = (APP.felgeSeasonList||[]).some(r=>r.season===season);
  if (exists) return;
  const today = new Date().toISOString().slice(0,10);
  const marker = `${FELGE_SEASON_MARKER_PREFIX}${season}`;
  const {error} = await sb.from('other_income').insert({team_id:APP.team.id,description:marker,amount:0,date:today});
  if (error) { alert('Fehler beim Anlegen der Saison: '+error.message); return; }
}
// Summe aller Felgen eines Mitglieds über ALLE Saisons (Saison 1 + Supabase-Saisons)
function getTotalFelgeCountForMember(memberId){
  let total = parseInt((APP.members.find(x=>String(x.id)===String(memberId))||{}).felge_count||0,10)||0;
  (APP.felgeEntries||[]).forEach(r=>{
    if (String(r.member_id)===String(memberId)) total += parseInt(r.count||0,10)||0;
  });
  return total;
}
// Gesamtsumme aller Felgen aller Mitglieder über alle Saisons
function getTotalFelgesAllMembers(){
  let total = APP.members.reduce((s,m)=>s+(parseInt(m.felge_count,10)||0),0);
  (APP.felgeEntries||[]).forEach(r=>{ total += parseInt(r.count||0,10)||0; });
  return total;
}

