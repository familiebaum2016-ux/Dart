  }
});

// Supabase-Client zurücksetzen und neu erstellen
function resetSupabaseClient() {
  try {
    localStorage.removeItem('sb-dartpro-auth');
    sessionStorage.removeItem('sb-dartpro-auth');
  } catch(_) {}
  sb = supabase.createClient(SUPABASE_URL, SUPABASE_KEY, {
    auth: {
      persistSession: true,
      autoRefreshToken: true,
      storage: localStorage,
      storageKey: 'sb-dartpro-auth',
      detectSessionInUrl: false
    }
  });
}

// ── SESSION MANAGEMENT ──
const SESSION_TIMEOUT = 5 * 60 * 1000;
let inactivityTimer = null;
let warningTimer    = null;
let sessionExpired  = false;

function updateActivity() {
  localStorage.setItem('dartpro_last_active', Date.now().toString());
  resetInactivityTimer();
}
function resetInactivityTimer() {
  if (inactivityTimer) clearTimeout(inactivityTimer);
  if (warningTimer) clearTimeout(warningTimer);
  if (!APP.user || sessionExpired) return;
  warningTimer = setTimeout(() => showSessionWarning(), SESSION_TIMEOUT - 30000);
  inactivityTimer = setTimeout(() => {
    forceLogout('Sitzung abgelaufen - Bitte neu anmelden.');
  }, SESSION_TIMEOUT);
}
function showSessionWarning() {
  if (document.getElementById('session-warning-modal')) return;
  const m = document.createElement('div');
  m.id = 'session-warning-modal';
  m.className = 'modal-overlay';
  m.innerHTML = `<div class="modal-box" style="border-color:var(--accent3)">
    <h3 style="color:var(--accent3)">&#9200; Sitzung läuft ab</h3>
    <p style="color:var(--text);margin-bottom:16px">Deine Sitzung läuft in 30 Sekunden ab. Klicke auf "Weitersurfen" um aktiv zu bleiben.</p>
    <div style="display:flex;gap:10px;justify-content:flex-end">
      <button class="btn btn-primary" onclick="dismissSessionWarning()">Weitersurfen</button>
    </div></div>`;
  document.body.appendChild(m);
}
function dismissSessionWarning() {
  const m = document.getElementById('session-warning-modal');
  if (m) m.remove();
  updateActivity();
}
async function forceLogout(msg) {
  sessionExpired = true;
  localStorage.removeItem('sb-dartpro-auth');
  localStorage.removeItem('dartpro_last_active');
  APP.user=null; APP.profile=null; APP.team=null;
  if (inactivityTimer) clearTimeout(inactivityTimer);
  if (warningTimer) clearTimeout(warningTimer);
  const w = document.getElementById('session-warning-modal');
  if (w) w.remove();
  document.getElementById('login-screen').style.display='';
  document.getElementById('screen-main').classList.remove('active');
  document.getElementById('screen-main').innerHTML='';
  loginMode='login'; renderLogin();
  if (msg) showMsg('error', msg);
}
['click','keydown','mousemove','scroll','touchstart'].forEach(ev => {
  document.addEventListener(ev, () => { if (APP.user && !sessionExpired) updateActivity(); }, {passive:true});
});

const APP = { user: null, profile: null, team: null, members: [], paidMonths: [], penalties: [], otherIncome: [], otherExpenses: [], announcements: [], registrations: [], felgeEntries: [], felgeSeasonList: [] };
let loginMode = 'login';
let currentTab = 'kader';
let currentRegistrationSeason = '2026/2027';
let currentFelgeSeason = 'Saison 1';
let superadminTab = 'teams';
let allTeams = [];
let allProfiles = [];
let saTeamId = null;
let saAnnouncements = [];
const REGISTRATION_MARKER_PREFIX = '__ANMELDUNG__|';
const FELGE_MARKER_PREFIX = '__FELGE__|';
const FELGE_SEASON_MARKER_PREFIX = '__FELGE_SEASON__|';

function esc(s) { if (!s) return ''; return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;'); }
function fmtDate(d) { if (!d) return '-'; const x = new Date(d); return x.toLocaleDateString('de-DE',{day:'2-digit',month:'2-digit',year:'numeric'}); }
function fmtDateTime(d) { if (!d) return '-'; const x = new Date(d); return x.toLocaleDateString('de-DE',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'}); }
function showMsg(t,m) { const el=document.getElementById('login-msg'); if(!el)return; el.innerHTML=`<div class="${t==='error'?'error-msg':'success-msg'}">${esc(m)}</div>`; setTimeout(()=>{if(el)el.innerHTML='';},5000); }

// LOGIN
async function doLogin(e,p) {
  try {
    resetSupabaseClient();
    APP.user = null; APP.profile = null; APP.team = null;
    const loginPromise = sb.auth.signInWithPassword({email:e,password:p});
    const timeoutPromise = new Promise((_, reject) =>
      setTimeout(() => reject(new Error('Login-Timeout - Bitte Seite neu laden und nochmal versuchen')), 10000)
    );
    const {data,error} = await Promise.race([loginPromise, timeoutPromise]);
    if (error) { showMsg('error','Login fehlgeschlagen: '+error.message); return false; }
    if (!data.user) { showMsg('error','Login fehlgeschlagen - Bitte nochmal versuchen'); return false; }
    APP.user = data.user;
    sessionExpired = false;
    updateActivity();
    await loadProfile();
    return true;
  } catch(err) {
    showMsg('error', err.message || 'Fehler beim Einloggen - Bitte Seite neu laden');
    return false;
  }
}
async function doSignup(e,p) {
  try {
    const {data,error} = await sb.auth.signUp({email:e,password:p});
    if (error) { showMsg('error','Registrierung fehlgeschlagen: '+error.message); return; }
    showMsg('success','Registriert! Prüfe deine E-Mail oder logge dich direkt ein.');
    loginMode='login'; renderLogin();
  } catch(err) { showMsg('error','Fehler: '+err.message); }
}
async function doLogout() {
  if (inactivityTimer) clearTimeout(inactivityTimer);
  if (warningTimer) clearTimeout(warningTimer);
  localStorage.removeItem('sb-dartpro-auth');
  localStorage.removeItem('dartpro_last_active');
  sessionExpired = false;
  APP.user=null; APP.profile=null; APP.team=null;
  document.getElementById('login-screen').style.display='';
  document.getElementById('screen-main').classList.remove('active');
  document.getElementById('screen-main').innerHTML='';
  loginMode='login'; renderLogin();
}
async function loadProfile() {
  try {
    const {data,error} = await sb.from('profiles').select('*, teams(*)').eq('id',APP.user.id).single();
    if (error || !data) { showMsg('error','Profil nicht gefunden.'); return; }
    APP.profile = data; APP.team = data.teams;
    document.getElementById('login-screen').style.display='none';
    document.getElementById('screen-main').classList.add('active');
    sessionExpired = false;
    updateActivity();
    if (APP.profile.role==='superadmin') { await renderSuperadmin(); return; }
    if (!APP.team) { renderNoTeam(); return; }
    await loadTeamData(); renderTeamView();
  } catch(err) { console.error(err); }
}
function renderLogin() {
  document.getElementById('login-screen').style.display='';
  document.getElementById('screen-main').classList.remove('active');
  document.getElementById('login-title').textContent = loginMode==='login'?'Anmelden':'Registrieren';
  document.getElementById('login-btn').textContent = loginMode==='login'?'Einloggen':'Konto erstellen';
  document.getElementById('toggle-login-link').textContent = loginMode==='login'?'Registrieren':'Anmelden';
}
function toggleLogin() { loginMode = loginMode==='login'?'signup':'login'; renderLogin(); }
async function handleLogin() {
  const e = document.getElementById('login-email').value.trim();
  const p = document.getElementById('login-password').value;
  if (!e||!p) { showMsg('error','Bitte E-Mail und Passwort eingeben.'); return; }
  if (p.length<6) { showMsg('error','Passwort muss mindestens 6 Zeichen haben.'); return; }
  const btn = document.getElementById('login-btn');
  btn.disabled = true; btn.textContent = '...';
  try {
    if (loginMode==='login') await doLogin(e,p); else await doSignup(e,p);
  } finally {
    btn.disabled = false;
    btn.textContent = loginMode==='login' ? 'Einloggen' : 'Konto erstellen';
  }
}
function renderNoTeam() {
  document.getElementById('screen-main').innerHTML = renderUserBar() + `
    <div class="card" style="text-align:center;padding:60px 24px">
      <div style="font-size:3rem;margin-bottom:16px">&#128274;</div>
