function switchTab(t) {
  currentTab=t;
  ['tab-kader','tab-registration','tab-birthdays','tab-felgeking','tab-announcements'].forEach(id=>{const el=document.getElementById(id);if(el)el.style.display=id==='tab-'+t?'':'none';});
  document.querySelectorAll('.tabs .tab').forEach(tb=>tb.classList.remove('active'));
  const at=document.querySelector(`.tabs .tab[onclick*="${t}"]`);if(at)at.classList.add('active');
}

