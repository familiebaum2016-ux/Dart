async function deleteMember(id) { if(!confirm('Mitglied löschen?'))return; await sb.from('members').delete().eq('id',id); await loadTeamData(); renderTeamView(); }
async function togglePM(mid,mi) {
  const ex = APP.paidMonths.find(pm=>pm.member_id===mid&&pm.month_index===mi);
  if(ex) await sb.from('paid_months').delete().eq('id',ex.id);
  else await sb.from('paid_months').insert({member_id:mid,month_index:mi});
  await loadTeamData(); renderTeamView();
}
function setRegistrationSeason(season) {
  currentRegistrationSeason = season;
  renderTeamView();
}
function shiftRegistrationSeason(delta) {
  currentRegistrationSeason = registrationSeasonLabel(registrationSeasonStart(currentRegistrationSeason)+delta);
  renderTeamView();
}
async function toggleRegistrationPaid(memberId) {
  const admin = APP.profile.role==='admin'||APP.profile.role==='superadmin';
  if (!admin) return;
  const season = currentRegistrationSeason;
  const existing = APP.registrations.find(r=>r.season===season && String(r.member_id)===String(memberId));
  if (existing) {
    const {error} = await sb.from('other_income').delete().eq('id',existing.id);
    if (error) { alert('Fehler beim Speichern: '+error.message); return; }
  } else {
    const today = new Date().toISOString().slice(0,10);
    const marker = `${REGISTRATION_MARKER_PREFIX}${season}|${memberId}`;
    const {error} = await sb.from('other_income').insert({team_id:APP.team.id,description:marker,amount:0,date:today});
    if (error) { alert('Fehler beim Speichern: '+error.message); return; }
  }
  await loadTeamData(); renderTeamView();
}
