function renderFelgeKing() {
  if (APP.members.length===0) return '<div class="card"><p style="color:var(--text3);text-align:center;padding:40px">Noch keine Mitglieder</p></div>';
  const FC = parseFloat(APP.team.felge_cost);
  const admin = APP.profile.role==='admin'||APP.profile.role==='superadmin';
  const season = currentFelgeSeason;
  const seasonList = felgeAvailableSeasons();
  const seasonOptions = seasonList.map(s=>`<option value="${esc(s)}" ${s===season?'selected':''}>${esc(s)}</option>`).join('');
  const isSeason1 = season === 'Saison 1';

  const enriched = APP.members.map(m=>({m, fc: getFelgeCountForMember(m.id, season)}));
  const sorted = [...enriched].sort((a,b)=>b.fc-a.fc);

  let html = `<div class="card">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap;margin-bottom:18px">
      <div>
        <div class="card-title" style="margin-bottom:8px"><div class="icon">&#128081;</div> Felgenkönig</div>
        <h2 style="font-size:1.6rem;color:var(--accent);margin-bottom:4px">${esc(season)}</h2>
        <p style="color:var(--text2);font-size:.88rem">${isSeason1?'Bestandsdaten aus Saison 1 (nur einsehbar).':'Felgen pro Spieler in dieser Saison.'}</p>
      </div>
      <div style="display:flex;gap:8px;align-items:end;flex-wrap:wrap">
        <div class="form-group" style="min-width:170px;flex:0">
          <label>Saison wählen</label>
          <select id="felge-season-select" onchange="setFelgeSeason(this.value)">${seasonOptions}</select>
        </div>
        ${admin?`<div class="form-group" style="min-width:150px;flex:0">
          <label>Neue Saison starten</label>
          <div style="display:flex;gap:6px">
            <input type="text" id="felge-new-season" placeholder="z.B. Saison 3">
            <button class="btn btn-primary btn-sm" onclick="addFelgeSeason()">+</button>
          </div>
        </div>`:''}
      </div>
    </div>`;

  if (admin && !isSeason1) {
    html += `<div class="card-title" style="margin-top:8px"><div class="icon">&#9998;</div> Felgen eintragen (${esc(season)})</div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:10px;margin-bottom:20px">`;
    APP.members.forEach(m=>{
      const val = getFelgeCountForMember(m.id, season);
      html += `<div style="background:var(--bg3);border:1px solid var(--bg4);border-radius:var(--radius);padding:10px 12px;display:flex;align-items:center;gap:10px">
        <div style="flex:1;font-family:'Oswald';font-size:1rem">${esc(m.name)}</div>
        <input type="number" min="0" value="${val}" id="felge-input-${m.id}" style="width:80px;text-align:center">
        <button class="btn btn-primary btn-sm" onclick="saveFelgeInput(${m.id})">OK</button>
      </div>`;
    });
    html += `</div>`;
  } else if (admin && isSeason1) {
    html += `<div style="background:var(--bg3);border:1px dashed var(--bg4);border-radius:var(--radius);padding:12px;margin-bottom:20px;font-size:.85rem;color:var(--text2)">
      Saison 1 zeigt den Bestand aus der Mitglieder-Tabelle. Für neue Einträge oben eine andere Saison auswählen oder eine neue Saison starten.
    </div>`;
  }

  html += `<div class="felge-ranking">`;
  sorted.forEach((row,i)=>{
    const m=row.m, fc=row.fc, fv=fc*FC;
    const r=i+1;
    let rc='',rcc='';
    if(r===1){rc='rank-1';rcc='gold';}else if(r===2){rc='rank-2';rcc='silver';}else if(r===3){rc='rank-3';rcc='bronze';}
    const medal = r===1?'&#129351;':r===2?'&#129352;':r===3?'&#129353;':'';
    html+=`<div class="felge-entry ${rc}"><div class="felge-rank ${rcc}">${medal||'#'+r}</div>
      <div class="felge-info"><div class="felge-name">${esc(m.name)}</div><div class="felge-count">${fc} Felgen</div></div>
      <div class="felge-value">${fv.toFixed(2)} €</div></div>`;
  });
  html += `</div></div>`;
  return html;
}

function setFelgeSeason(s){
  currentFelgeSeason = s;
  saveCurrentFelgeSeason(s);
  renderTeamView();
}
async function addFelgeSeason(){
  const inp = document.getElementById('felge-new-season');
  if (!inp) return;
  let raw = (inp.value||'').trim();
  if (!raw) { alert('Bitte Namen für die neue Saison eingeben (z.B. "Saison 3").'); return; }
  if (/^\d+$/.test(raw)) raw = 'Saison '+raw;
  if (!/^Saison\s+\d+$/i.test(raw)) {
    if (!confirm('Der Name entspricht nicht dem Muster "Saison X". Trotzdem anlegen?')) return;
  }
  await ensureFelgeSeasonExists(raw);
  currentFelgeSeason = raw;
  saveCurrentFelgeSeason(raw);
  await loadTeamData(); renderTeamView();
}
async function saveFelgeInput(memberId){
  const el = document.getElementById('felge-input-'+memberId);
  if (!el) return;
  const v = parseInt(el.value,10)||0;
  await ensureFelgeSeasonExists(currentFelgeSeason);
  await setFelgeCountForMember(memberId, currentFelgeSeason, v);
  await loadTeamData(); renderTeamView();
}

