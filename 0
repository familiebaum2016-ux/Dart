// INIT
async function init() {
  renderLogin();
  try {
    const sessionPromise = sb.auth.getSession();
    const timeoutPromise = new Promise((_, reject) => setTimeout(() => reject(new Error('timeout')), 8000));
    const {data} = await Promise.race([sessionPromise, timeoutPromise]);
    const session = data?.session;

    if (session?.user) {
      const lastActive = parseInt(localStorage.getItem('dartpro_last_active') || '0');
      const now = Date.now();
      const withinGracePeriod = (now - lastActive) < SESSION_TIMEOUT;

      if (withinGracePeriod) {
        APP.user = session.user;
        await loadProfile();
      } else {
        localStorage.removeItem('sb-dartpro-auth');
        localStorage.removeItem('dartpro_last_active');
        renderLogin();
      }
    } else {
      renderLogin();
    }
  } catch(err) {
    console.error('Init error:', err);
    localStorage.removeItem('sb-dartpro-auth');
    localStorage.removeItem('dartpro_last_active');
    renderLogin();
  }
}

let initDone = false;
sb.auth.onAuthStateChange(async (ev, session) => {
  if (ev === 'INITIAL_SESSION') return;
  if (ev === 'SIGNED_IN' && session?.user && APP.user === null) {
    if (!initDone) { initDone = true; APP.user = session.user; await loadProfile(); }
  } else if (ev === 'SIGNED_OUT' && !sessionExpired) {
    APP.user=null; APP.profile=null; APP.team=null;
    if (inactivityTimer) clearTimeout(inactivityTimer);
    if (warningTimer) clearTimeout(warningTimer);
    localStorage.removeItem('dartpro_last_active');
    renderLogin();
  } else if (ev === 'TOKEN_REFRESHED' && session?.user) {
    updateActivity();
  }
});

document.getElementById('login-btn').addEventListener('click',handleLogin);
document.getElementById('toggle-login-link').addEventListener('click',toggleLogin);
document.getElementById('login-password').addEventListener('keypress',e=>{if(e.key==='Enter')handleLogin();});

init();
</script>
